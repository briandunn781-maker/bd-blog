PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bd-blog
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact page: your address is only revealed after a Cloudflare Turnstile bot check.
# In development the Turnstile secret falls back to Cloudflare's test key automatically.
CONTACT_EMAIL=you@example.com
TURNSTILE_SECRET_KEY=

# Used by `npm run seed:admin` to create (or reset) the admin account
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
